# ------------------------------------------------------------------ Duda
# Website builder API. From the Duda account owner (currently Bullsai).
# The one hard dependency for publishing.
DUDA_API_USER=
DUDA_API_PASS=
DUDA_SITE_NAME=
# DUDA_API_BASE=https://api.duda.co

# ------------------------------------------------------------------ DataForSEO
# Real search volumes and difficulty for the target queries. Pay as you go;
# pricing this whole query set costs well under $1.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ------------------------------------------------------------------ Google Search Console
# What Google already shows Wolff for. Option A needs no keys: export the
# Performance CSV and run scripts/connectors/gsc.js --csv <file>.
# Option B (weekly automation): a service account JSON added as a user on the
# Search Console property.
GSC_SITE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------ PageSpeed Insights
# Site speed measurements from Google's servers. Works without a key at a low
# rate limit; a free key from console.cloud.google.com removes the limit.
PSI_API_KEY=

# ------------------------------------------------------------------ Voyage AI
# Embeddings for semantic search-to-page matching (Anthropic's recommended
# embeddings partner; Anthropic itself has no embeddings endpoint).
# Free tier at voyageai.com covers this site's size easily.
VOYAGE_API_KEY=
