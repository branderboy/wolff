<!--
  Project (case study) template. Keep the display name ("Silk & Sage") as the
  visible H1 prefix; the URL, title tag, and schema carry service + city.
  Minimum 600 words. Every fact sourced from data/projects.json.
-->
<article>
  <h1>{{project.displayName}} — {{project.service}} in {{project.city}}, CA</h1>

  <section><h2>The brief</h2><!-- what the client asked for, project scope --></section>
  <section><h2>What we changed</h2><!-- structural/layout decisions, materials --></section>
  <section><h2>Problems we solved</h2><!-- the specific, citable part --></section>
  <section><h2>Timeline and investment</h2><!-- table: duration, scope tier, investment band --></section>
  <section><h2>The team</h2><!-- named PM and trades, linked to team pages --></section>
  <section><h2>What the client said</h2><!-- review from data/reviews.json with schema --></section>
</article>
